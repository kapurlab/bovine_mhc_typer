#!/usr/bin/env bash
# MHC Typer GUI OOD batch_connect script.
# $port (uvicorn) is exported by before.sh.

echo "=== MHC Typer GUI Session Starting ==="
echo "uvicorn:${port}"

# Shared conda env installed at the tool root.
# Falls back to a personal install if the shared env is absent.
SHARED_ENV=/srv/kapurlab/tools/mhc_gui/env
PERSONAL_ENV=/home/${USER}/miniforge3/envs/mhc_gui
PERSONAL_BASE_PYTHON=/home/${USER}/miniforge3/bin/python

if [ -d "${SHARED_ENV}" ] && [ -x "${SHARED_ENV}/bin/python" ]; then
  MHC_ENV="${SHARED_ENV}"
  PYTHON="${SHARED_ENV}/bin/python"
elif [ -d "${PERSONAL_ENV}" ]; then
  MHC_ENV="${PERSONAL_ENV}"
  PYTHON="${PERSONAL_ENV}/bin/python"
else
  MHC_ENV=""
  PYTHON="${PERSONAL_BASE_PYTHON}"
fi

# Tool source (shared install only — no per-user fallback for the app itself)
MHC_GUI=/srv/kapurlab/tools/mhc_gui

# Put the tool's own env bin on PATH so the whole pipeline toolchain
# (minimap2/samtools/bcftools/nanoq/vsearch/spoa/medaka/blastn) resolves from it.
export PATH="${MHC_ENV}/bin:${PATH}"
# Export CONDA_PREFIX so bioconda tools locate their packaged share/ data
# (e.g. medaka). Harmless when MHC_ENV is empty.
[ -n "${MHC_ENV}" ] && export CONDA_PREFIX="${MHC_ENV}"
# PYTHONPATH lets the bin/ pipeline scripts find each other (local imports).
export PYTHONPATH="${MHC_GUI}/bin:${PYTHONPATH}"

cd "${MHC_GUI}/backend"
echo "Starting uvicorn on port ${port}"
echo "  conda env: ${MHC_ENV}"
echo "  mhc_gui:   ${MHC_GUI}"
exec $PYTHON -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port "${port}" \
    --log-level info
